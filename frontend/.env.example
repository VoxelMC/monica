# Copy to .env.development (dev) or set in the container env (production).
MONICA_URL=http://127.0.0.1:8081
# Optional: Monica as the browser sees it, for "Open in Monica" links
MONICA_PUBLIC_URL=
MONICA_TOKEN=replace-with-a-personal-access-token
ORBIT_READ_ONLY=true
ORBIT_DRY_RUN=false
ORBIT_DB_PATH=./data/orbit.sqlite
